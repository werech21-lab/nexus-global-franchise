NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Lemon Squeezy: online payment of the 2% deal commission (server only, never NEXT_PUBLIC)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
# Variant of the one-time "Nexus deal commission" product (custom price is set per checkout)
LEMONSQUEEZY_VARIANT_ID=
# Signing secret of the webhook pointing to /api/payments/lemonsqueezy/webhook
LEMONSQUEEZY_WEBHOOK_SECRET=
# Set to true only while testing with a test-mode store/key; test orders are ignored otherwise
LEMONSQUEEZY_ACCEPT_TEST_MODE=
# Optional explicit conversion to the store currency, e.g. KWD:3.25 (1 KWD = 3.25 USD).
# Without an entry, deals in another currency cannot be paid online.
COMMISSION_FX_RATES=
# Required by the checkout and webhook routes
SUPABASE_SERVICE_ROLE_KEY=
